# ==========================================
# MealSync Backend Environment Variables
# ==========================================

# Server Port and Host
PORT=3000
HOST=0.0.0.0

# CORS Allowed Origins
# Example: https://aws-hackathon-six.vercel.app,*
ALLOWED_ORIGINS=https://aws-hackathon-six.vercel.app,*

# MongoDB Atlas Connection URI
# Ensure you allow access from anywhere (0.0.0.0/0) in MongoDB Atlas Network Access
# so that Render's dynamic IP addresses can establish a connection.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=AWS-hackathon
DB_CONNECT_STRING=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=AWS-hackathon
